<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#090b16">
  <meta name="description" content="Play a free online 10-minute retro arcade game for office break. Take a quick workday break, dodge incoming pixels, collect energy and beat your high score.">
  <meta name="robots" content="index, follow, max-image-preview:large">
  <meta property="og:title" content="Free Online 10-Minute Retro Arcade Game for Office Break">
  <meta property="og:description" content="A quick retro arcade challenge built for short office breaks. Play instantly and chase your high score.">
  <meta property="og:type" content="website">
  <title>Free Online 10-Minute Retro Arcade Game for Office Break</title>

  <style>
    :root{
      --bg:#080a13;
      --panel:#111526;
      --panel2:#171c32;
      --text:#f5f7ff;
      --muted:#9ba5c4;
      --cyan:#39f3ff;
      --pink:#ff4fa3;
      --yellow:#ffe66d;
      --green:#5dff9a;
      --border:rgba(255,255,255,.10);
      --shadow:0 20px 60px rgba(0,0,0,.45);
    }

    *{box-sizing:border-box}

    html{scroll-behavior:smooth}

    body{
      margin:0;
      min-height:100vh;
      color:var(--text);
      background:
        radial-gradient(circle at 20% 0%,rgba(57,243,255,.10),transparent 28%),
        radial-gradient(circle at 90% 20%,rgba(255,79,163,.10),transparent 28%),
        linear-gradient(180deg,#080a13 0%,#0b0e1b 100%);
      font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
      overflow-x:hidden;
    }

    body:before{
      content:"";
      position:fixed;
      inset:0;
      pointer-events:none;
      opacity:.035;
      background-image:
        linear-gradient(rgba(255,255,255,.7) 1px,transparent 1px),
        linear-gradient(90deg,rgba(255,255,255,.7) 1px,transparent 1px);
      background-size:32px 32px;
    }

    .wrap{
      width:min(1040px,94%);
      margin:auto;
    }

    header{
      text-align:center;
      padding:38px 0 24px;
    }

    .badge{
      display:inline-flex;
      align-items:center;
      gap:8px;
      padding:7px 12px;
      border:1px solid rgba(57,243,255,.25);
      background:rgba(57,243,255,.07);
      color:var(--cyan);
      border-radius:999px;
      font-size:12px;
      font-weight:800;
      letter-spacing:.12em;
      text-transform:uppercase;
      box-shadow:0 0 25px rgba(57,243,255,.06);
    }

    h1{
      max-width:900px;
      margin:18px auto 12px;
      font-size:clamp(30px,6vw,58px);
      line-height:1.02;
      letter-spacing:-.045em;
    }

    .intro{
      max-width:720px;
      margin:0 auto;
      color:var(--muted);
      font-size:clamp(15px,2vw,18px);
      line-height:1.7;
    }

    .game-shell{
      margin:25px auto 0;
      padding:12px;
      max-width:920px;
      background:linear-gradient(145deg,rgba(255,255,255,.09),rgba(255,255,255,.025));
      border:1px solid var(--border);
      border-radius:24px;
      box-shadow:var(--shadow);
    }

    .game-frame{
      position:relative;
      overflow:hidden;
      border-radius:17px;
      background:#050711;
      border:1px solid rgba(57,243,255,.14);
    }

    canvas{
      display:block;
      width:100%;
      height:auto;
      aspect-ratio:16/9;
      background:#050711;
      image-rendering:pixelated;
      touch-action:none;
    }

    .hud{
      position:absolute;
      inset:0 0 auto 0;
      display:flex;
      justify-content:space-between;
      align-items:flex-start;
      padding:14px;
      pointer-events:none;
      background:linear-gradient(180deg,rgba(3,5,12,.72),transparent);
    }

    .stat{
      min-width:85px;
      padding:7px 10px;
      border:1px solid rgba(255,255,255,.10);
      border-radius:10px;
      background:rgba(5,7,17,.72);
      backdrop-filter:blur(8px);
    }

    .stat small{
      display:block;
      color:#7f89a8;
      font-size:9px;
      font-weight:800;
      letter-spacing:.12em;
      text-transform:uppercase;
    }

    .stat strong{
      display:block;
      margin-top:2px;
      font-size:18px;
      color:white;
    }

    .screen{
      position:absolute;
      inset:0;
      display:flex;
      align-items:center;
      justify-content:center;
      text-align:center;
      padding:25px;
      background:rgba(3,5,12,.56);
      backdrop-filter:blur(3px);
    }

    .screen.hidden{display:none}

    .screen-card{
      width:min(450px,92%);
      padding:28px 24px;
      border:1px solid rgba(255,255,255,.12);
      border-radius:20px;
      background:rgba(13,17,33,.92);
      box-shadow:0 25px 70px rgba(0,0,0,.5);
    }

    .screen-card h2{
      margin:0 0 8px;
      font-size:clamp(24px,5vw,36px);
    }

    .screen-card p{
      margin:0 0 20px;
      color:var(--muted);
      line-height:1.6;
    }

    button{
      border:0;
      cursor:pointer;
      font:inherit;
      font-weight:900;
    }

    .primary{
      min-height:48px;
      padding:0 22px;
      border-radius:12px;
      color:#050711;
      background:linear-gradient(135deg,var(--cyan),#9affff);
      box-shadow:0 8px 30px rgba(57,243,255,.18);
      transition:transform .18s ease,box-shadow .18s ease;
    }

    .primary:hover{
      transform:translateY(-2px);
      box-shadow:0 12px 38px rgba(57,243,255,.30);
    }

    .primary:active{transform:translateY(1px)}

    .controls{
      display:flex;
      flex-wrap:wrap;
      justify-content:center;
      gap:10px;
      margin:15px 0 5px;
    }

    .control-note{
      color:#818ba8;
      font-size:13px;
      text-align:center;
      margin-top:12px;
    }

    .mobile-controls{
      display:none;
      grid-template-columns:repeat(3,64px);
      justify-content:center;
      gap:8px;
      margin:14px auto 2px;
    }

    .mobile-controls button{
      height:54px;
      border-radius:14px;
      color:#eafcff;
      background:#171d31;
      border:1px solid rgba(255,255,255,.09);
      font-size:20px;
    }

    .mobile-controls .up{grid-column:2}

    .support{
      position:relative;
      overflow:hidden;
      max-width:920px;
      margin:25px auto 0;
      padding:30px;
      border-radius:22px;
      border:1px solid rgba(255,79,163,.22);
      background:
        radial-gradient(circle at 90% 10%,rgba(255,79,163,.14),transparent 30%),
        linear-gradient(145deg,#171426,#101323);
      box-shadow:var(--shadow);
      display:flex;
      align-items:center;
      justify-content:space-between;
      gap:25px;
    }

    .support h2{
      margin:0 0 7px;
      font-size:clamp(21px,3vw,29px);
    }

    .support p{
      margin:0;
      color:var(--muted);
      line-height:1.55;
    }

    .coffee{
      flex:none;
      display:inline-flex;
      align-items:center;
      justify-content:center;
      min-height:50px;
      padding:0 22px;
      border-radius:12px;
      background:linear-gradient(135deg,#ff4fa3,#ff7cbd);
      color:white;
      text-decoration:none;
      font-weight:900;
      box-shadow:0 10px 35px rgba(255,79,163,.20);
      transition:transform .18s ease,box-shadow .18s ease;
    }

    .coffee:hover{
      transform:translateY(-2px);
      box-shadow:0 15px 42px rgba(255,79,163,.32);
    }

    .info{
      max-width:920px;
      margin:35px auto 70px;
      display:grid;
      grid-template-columns:repeat(3,1fr);
      gap:14px;
    }

    .info-card{
      padding:20px;
      border:1px solid var(--border);
      background:rgba(17,21,38,.72);
      border-radius:16px;
    }

    .info-card strong{
      display:block;
      margin-bottom:7px;
      font-size:15px;
    }

    .info-card span{
      color:var(--muted);
      font-size:13px;
      line-height:1.55;
    }

    @media(max-width:700px){
      header{padding-top:28px}
      .game-shell{padding:7px;border-radius:17px}
      .hud{padding:8px}
      .stat{min-width:67px;padding:6px 8px}
      .stat strong{font-size:14px}
      .stat small{font-size:8px}
      .mobile-controls{display:grid}
      .support{
        flex-direction:column;
        align-items:stretch;
        text-align:center;
        padding:25px 20px;
      }
      .coffee{width:100%}
      .info{grid-template-columns:1fr;margin-bottom:45px}
      .control-note{display:none}
    }
  </style>
</head>

<body>
  <main class="wrap">

    <header>
      <div class="badge">⚡ 10-Minute Retro Break</div>

      <h1>Free Online 10-Minute Retro Arcade Game for Office Break</h1>

      <p class="intro">
        Take a quick reset from your workday with this free online 10-minute retro arcade game for office break sessions. 
        Dodge hazards, collect energy and see how high you can score before heading back to work.
      </p>
    </header>

    <section class="game-shell" aria-label="Retro arcade game">
      <div class="game-frame">

        <canvas id="game" width="960" height="540"></canvas>

        <div class="hud">
          <div class="stat">
            <small>Score</small>
            <strong id="score">0</strong>
          </div>

          <div class="stat">
            <small>High Score</small>
            <strong id="highScore">0</strong>
          </div>

          <div class="stat">
            <small>Time</small>
            <strong id="time">10:00</strong>
          </div>
        </div>

        <div class="screen" id="startScreen">
          <div class="screen-card">
            <h2>PIXEL BREAK</h2>
            <p>
              Survive the falling blocks, collect glowing energy and build the biggest score you can.
              Perfect for a quick desk break.
            </p>
            <button class="primary" id="startBtn">START GAME</button>
          </div>
        </div>

        <div class="screen hidden" id="gameOverScreen">
          <div class="screen-card">
            <h2 id="gameOverTitle">TIME!</h2>
            <p id="gameOverText">Your final score was 0.</p>
            <button class="primary" id="restartBtn">PLAY AGAIN</button>
          </div>
        </div>

      </div>

      <div class="controls">
        <div class="control-note">Move with ← → or A / D · Collect cyan energy · Avoid red blocks</div>
      </div>

      <div class="mobile-controls" aria-label="Touch controls">
        <button class="up" id="touchBoost" aria-label="Boost">▲</button>
        <button id="touchLeft" aria-label="Move left">◀</button>
        <button id="touchRight" aria-label="Move right">▶</button>
      </div>
    </section>

    <section class="support">
      <div>
        <h2>☕ Did this rescue your workday break?</h2>
        <p>
          If Pixel Break gave you a few minutes of fun, consider buying the developer a coffee.
          It helps keep little browser games like this alive.
        </p>
      </div>

      <a
        class="coffee"
        href="https://buymeacoffee.com/ashishanshs"
        target="_blank"
        rel="noopener noreferrer"
      >
        ☕ Buy Me a Coffee
      </a>
    </section>

    <section class="info">
      <div class="info-card">
        <strong>🎮 Instant Play</strong>
        <span>No installation, account or download required. Open the page and start playing.</span>
      </div>

      <div class="info-card">
        <strong>🏆 Chase Your Record</strong>
        <span>Your best score is saved locally in your browser so every short break can become a new challenge.</span>
      </div>

      <div class="info-card">
        <strong>⏱️ Quick Break Friendly</strong>
        <span>A compact arcade loop makes it easy to play for a few minutes and return to your work.</span>
      </div>
    </section>

  </main>

  <script>
    (() => {
      "use strict";

      const canvas = document.getElementById("game");
      const ctx = canvas.getContext("2d");

      const scoreEl = document.getElementById("score");
      const highScoreEl = document.getElementById("highScore");
      const timeEl = document.getElementById("time");

      const startScreen = document.getElementById("startScreen");
      const gameOverScreen = document.getElementById("gameOverScreen");
      const gameOverText = document.getElementById("gameOverText");
      const gameOverTitle = document.getElementById("gameOverTitle");

      const startBtn = document.getElementById("startBtn");
      const restartBtn = document.getElementById("restartBtn");

      const W = canvas.width;
      const H = canvas.height;

      const GAME_SECONDS = 600;

      let highScore = Number(localStorage.getItem("pixelBreakHighScore") || 0);
      highScoreEl.textContent = highScore.toLocaleString();

      let running = false;
      let score = 0;
      let elapsed = 0;
      let lastTime = 0;
      let animationId = 0;
      let spawnTimer = 0;
      let energyTimer = 0;
      let shake = 0;

      const keys = {
        left: false,
        right: false,
        boost: false
      };

      const player = {
        x: W / 2,
        y: H - 78,
        width: 34,
        height: 34,
        speed: 390,
        boostSpeed: 620
      };

      let obstacles = [];
      let energy = [];
      let particles = [];
      let stars = [];

      for (let i = 0; i < 85; i++) {
        stars.push({
          x: Math.random() * W,
          y: Math.random() * H,
          size: Math.random() * 2 + .5,
          speed: Math.random() * 18 + 5,
          alpha: Math.random() * .65 + .15
        });
      }

      function resetGame() {
        score = 0;
        elapsed = 0;
        spawnTimer = 0;
        energyTimer = 1.2;
        shake = 0;

        player.x = W / 2;

        obstacles = [];
        energy = [];
        particles = [];

        scoreEl.textContent = "0";
        timeEl.textContent = "10:00";
      }

      function startGame() {
        cancelAnimationFrame(animationId);
        resetGame();

        running = true;
        startScreen.classList.add("hidden");
        gameOverScreen.classList.add("hidden");

        lastTime = performance.now();
        animationId = requestAnimationFrame(loop);
      }

      function endGame(reason = "time") {
        running = false;
        cancelAnimationFrame(animationId);

        if (score > highScore) {
          highScore = score;
          localStorage.setItem("pixelBreakHighScore", String(highScore));
          highScoreEl.textContent = highScore.toLocaleString();
          gameOverTitle.textContent = "NEW HIGH SCORE!";
        } else {
          gameOverTitle.textContent = reason === "hit" ? "CRASHED!" : "TIME!";
        }

        gameOverText.textContent =
          `Final score: ${score.toLocaleString()} · High score: ${highScore.toLocaleString()}`;

        gameOverScreen.classList.remove("hidden");
      }

      function formatTime(seconds) {
        const remaining = Math.max(0, Math.ceil(GAME_SECONDS - seconds));
        const minutes = Math.floor(remaining / 60);
        const secs = remaining % 60;
        return `${String(minutes).padStart(2, "0")}:${String(secs).padStart(2, "0")}`;
      }

      function spawnObstacle() {
        const difficulty = 1 + Math.min(elapsed / 120, 2.5);

        const size = 18 + Math.random() * 27;
        const speed = (115 + Math.random() * 150) * difficulty;

        obstacles.push({
          x: Math.random() * (W - size),
          y: -size - 10,
          width: size,
          height: size,
          speed,
          rotation: Math.random() * Math.PI,
          rotationSpeed: (Math.random() - .5) * 4
        });
      }

      function spawnEnergy() {
        energy.push({
          x: 35 + Math.random() * (W - 70),
          y: -20,
          size: 9 + Math.random() * 5,
          speed: 105 + Math.random() * 80,
          pulse: Math.random() * Math.PI * 2
        });
      }

      function burst(x, y, color, amount = 12) {
        for (let i = 0; i < amount; i++) {
          const angle = Math.random() * Math.PI * 2;
          const speed = 40 + Math.random() * 170;

          particles.push({
            x,
            y,
            vx: Math.cos(angle) * speed,
            vy: Math.sin(angle) * speed,
            life: .4 + Math.random() * .5,
            maxLife: .9,
            size: 2 + Math.random() * 4,
            color
          });
        }
      }

      function circleRectCollision(circle, rect) {
        const closestX = Math.max(rect.x, Math.min(circle.x, rect.x + rect.width));
        const closestY = Math.max(rect.y, Math.min(circle.y, rect.y + rect.height));

        const dx = circle.x - closestX;
        const dy = circle.y - closestY;

        return dx * dx + dy * dy < circle.size * circle.size;
      }

      function rectCollision(a, b) {
        return (
          a.x < b.x + b.width &&
          a.x + a.width > b.x &&
          a.y < b.y + b.height &&
          a.y + a.height > b.y
        );
      }

      function update(dt) {
        elapsed += dt;

        if (elapsed >= GAME_SECONDS) {
          elapsed = GAME_SECONDS;
          timeEl.textContent = "00:00";
          endGame("time");
          return;
        }

        timeEl.textContent = formatTime(elapsed);

        let direction = 0;

        if (keys.left) direction -= 1;
        if (keys.right) direction += 1;

        const currentSpeed = keys.boost ? player.boostSpeed : player.speed;

        player.x += direction * currentSpeed * dt;
        player.x = Math.max(12, Math.min(W - player.width - 12, player.x));

        spawnTimer -= dt;
        energyTimer -= dt;

        const difficulty = Math.min(elapsed / 90, 3);

        if (spawnTimer <= 0) {
          spawnObstacle();
          spawnTimer = Math.max(.18, .65 - difficulty * .12);
        }

        if (energyTimer <= 0) {
          spawnEnergy();
          energyTimer = .65 + Math.random() * .8;
        }

        for (const star of stars) {
          star.y += star.speed * dt;

          if (star.y > H) {
            star.y = -4;
            star.x = Math.random() * W;
          }
        }

        for (let i = obstacles.length - 1; i >= 0; i--) {
          const o = obstacles[i];

          o.y += o.speed * dt;
          o.rotation += o.rotationSpeed * dt;

          if (o.y > H + 60) {
            obstacles.splice(i, 1);
            score += 2;
            scoreEl.textContent = score.toLocaleString();
            continue;
          }

          if (rectCollision(player, o)) {
            burst(player.x + player.width / 2, player.y + player.height / 2, "#ff4fa3", 30);
            shake = .35;
            endGame("hit");
            return;
          }
        }

        for (let i = energy.length - 1; i >= 0; i--) {
          const e = energy[i];

          e.y += e.speed * dt;
          e.pulse += dt * 5;

          if (e.y > H + 30) {
            energy.splice(i, 1);
            continue;
          }

          if (circleRectCollision(e, player)) {
            score += 25;
            scoreEl.textContent = score.toLocaleString();

            burst(e.x, e.y, "#39f3ff", 16);
            energy.splice(i, 1);
          }
        }

        for (let i = particles.length - 1; i >= 0; i--) {
          const p = particles[i];

          p.x += p.vx * dt;
          p.y += p.vy * dt;
          p.vy += 100 * dt;
          p.life -= dt;

          if (p.life <= 0) particles.splice(i, 1);
        }

        if (shake > 0) shake -= dt;
      }

      function drawBackground() {
        const gradient = ctx.createLinearGradient(0, 0, 0, H);
        gradient.addColorStop(0, "#070918");
        gradient.addColorStop(1, "#03040b");

        ctx.fillStyle = gradient;
        ctx.fillRect(0, 0, W, H);

        ctx.strokeStyle = "rgba(57,243,255,.055)";
        ctx.lineWidth = 1;

        for (let x = 0; x < W; x += 48) {
          ctx.beginPath();
          ctx.moveTo(x, 0);
          ctx.lineTo(x, H);
          ctx.stroke();
        }

        for (let y = 0; y < H; y += 48) {
          ctx.beginPath();
          ctx.moveTo(0, y);
          ctx.lineTo(W, y);
          ctx.stroke();
        }

        for (const star of stars) {
          ctx.globalAlpha = star.alpha;
          ctx.fillStyle = "#b7faff";
          ctx.fillRect(star.x, star.y, star.size, star.size);
        }

        ctx.globalAlpha = 1;

        const horizon = H - 125;

        ctx.strokeStyle = "rgba(255,79,163,.12)";
        ctx.beginPath();
        ctx.moveTo(0, horizon);
        ctx.lineTo(W, horizon);
        ctx.stroke();

        for (let x = -W; x < W * 2; x += 75) {
          ctx.beginPath();
          ctx.moveTo(W / 2, horizon);
          ctx.lineTo(x, H);
          ctx.stroke();
        }

        for (let y = horizon; y < H; y += 26) {
          ctx.beginPath();
          ctx.moveTo(0, y);
          ctx.lineTo(W, y);
          ctx.stroke();
        }
      }

      function drawPlayer() {
        const x = player.x + player.width / 2;
        const y = player.y + player.height / 2;

        ctx.save();

        ctx.shadowBlur = 24;
        ctx.shadowColor = "#39f3ff";

        ctx.fillStyle = "#39f3ff";
        ctx.beginPath();
        ctx.moveTo(x, player.y - 7);
        ctx.lineTo(player.x + player.width + 5, player.y + player.height + 7);
        ctx.lineTo(x, player.y + player.height - 4);
        ctx.lineTo(player.x - 5, player.y + player.height + 7);
        ctx.closePath();
        ctx.fill();

        ctx.shadowBlur = 0;

        ctx.fillStyle = "#08101b";
        ctx.beginPath();
        ctx.arc(x, y + 4, 5, 0, Math.PI * 2);
        ctx.fill();

        ctx.fillStyle = "#fff";
        ctx.fillRect(x - 2, y + 2, 4, 3);

        if (keys.boost) {
          ctx.shadowBlur = 20;
          ctx.shadowColor = "#ffe66d";
          ctx.fillStyle = "#ffe66d";

          ctx.beginPath();
          ctx.moveTo(x - 7, player.y + player.height - 1);
          ctx.lineTo(x, player.y + player.height + 18 + Math.random() * 8);
          ctx.lineTo(x + 7, player.y + player.height - 1);
          ctx.closePath();
          ctx.fill();
        }

        ctx.restore();
      }

      function drawObstacles() {
        for (const o of obstacles) {
          const cx = o.x + o.width / 2;
          const cy = o.y + o.height / 2;

          ctx.save();
          ctx.translate(cx, cy);
          ctx.rotate(o.rotation);

          ctx.shadowBlur = 18;
          ctx.shadowColor = "#ff4fa3";

          ctx.fillStyle = "#ff4fa3";
          ctx.fillRect(-o.width / 2, -o.height / 2, o.width, o.height);

          ctx.shadowBlur = 0;

          ctx.fillStyle = "#450d2a";
          ctx.fillRect(
            -o.width / 2 + 4,
            -o.height / 2 + 4,
            Math.max(3, o.width - 8),
            Math.max(3, o.height - 8)
          );

          ctx.fillStyle = "rgba(255,255,255,.7)";
          ctx.fillRect(-o.width / 2 + 4, -o.height / 2 + 4, 4, 4);

          ctx.restore();
        }
      }

      function drawEnergy() {
        for (const e of energy) {
          const pulse = 1 + Math.sin(e.pulse) * .12;

          ctx.save();
          ctx.translate(e.x, e.y);
          ctx.scale(pulse, pulse);

          ctx.shadowBlur = 24;
          ctx.shadowColor = "#39f3ff";

          ctx.fillStyle = "#39f3ff";
          ctx.beginPath();
          ctx.moveTo(0, -e.size);
          ctx.lineTo(e.size * .75, 0);
          ctx.lineTo(0, e.size);
          ctx.lineTo(-e.size * .75, 0);
          ctx.closePath();
          ctx.fill();

          ctx.shadowBlur = 0;
          ctx.fillStyle = "#fff";
          ctx.fillRect(-2, -2, 4, 4);

          ctx.restore();
        }
      }

      function drawParticles() {
        for (const p of particles) {
          ctx.globalAlpha = Math.max(0, p.life / p.maxLife);
          ctx.fillStyle = p.color;
          ctx.fillRect(p.x, p.y, p.size, p.size);
        }

        ctx.globalAlpha = 1;
      }

      function draw() {
        ctx.save();

        if (shake > 0) {
          ctx.translate(
            (Math.random() - .5) * 12,
            (Math.random() - .5) * 12
          );
        }

        drawBackground();
        drawEnergy();
        drawObstacles();
        drawPlayer();
        drawParticles();

        ctx.restore();
      }

      function loop(now) {
        if (!running) return;

        const dt = Math.min(.033, (now - lastTime) / 1000);
        lastTime = now;

        update(dt);
        draw();

        if (running) {
          animationId = requestAnimationFrame(loop);
        } else {
          draw();
        }
      }

      function setKey(key, value) {
        if (key === "ArrowLeft" || key.toLowerCase() === "a") keys.left = value;
        if (key === "ArrowRight" || key.toLowerCase() === "d") keys.right = value;
        if (key === " " || key === "ArrowUp" || key.toLowerCase() === "w") keys.boost = value;
      }

      window.addEventListener("keydown", e => {
        if (
          ["ArrowLeft","ArrowRight","ArrowUp"," ","a","d","w","A","D","W"].includes(e.key)
        ) {
          e.preventDefault();
        }

        setKey(e.key, true);
      }, {passive:false});

      window.addEventListener("keyup", e => {
        setKey(e.key, false);
      });

      function bindTouch(id, property) {
        const button = document.getElementById(id);

        const down = e => {
          e.preventDefault();
          keys[property] = true;
        };

        const up = e => {
          e.preventDefault();
          keys[property] = false;
        };

        button.addEventListener("pointerdown", down);
        button.addEventListener("pointerup", up);
        button.addEventListener("pointercancel", up);
        button.addEventListener("pointerleave", up);
      }

      bindTouch("touchLeft", "left");
      bindTouch("touchRight", "right");
      bindTouch("touchBoost", "boost");

      startBtn.addEventListener("click", startGame);
      restartBtn.addEventListener("click", startGame);

      draw();
    })();
  </script>
</body>
</html>
